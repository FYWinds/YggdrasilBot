#!/bin/sh
# reap [--keep-pgid N]... [--keep-tree PID]...
# Kill every process in the sandbox except PID 1 (tini), this script and its ancestor chain (the bot runs
# it through sandboxd's Execute, so the real sandboxd is its parent), everything still descending from that
# top ancestor below PID 1 (sandboxd: other Execute calls in flight, e.g. a job poller's helpers; finished
# calls' leftovers reparent to tini, so they are not spared), processes whose process-group id is listed via
# --keep-pgid, and every PID listed via --keep-tree together with all of its descendants (found by walking
# ppids: /proc/<pid>/task/*/children is empty under gVisor). Nothing is spared by name or binary: model code
# can name a process anything. SIGTERM first, SIGKILL whatever is still alive after 2s. Prints the number of
# processes signalled. Uses only /proc (works under gVisor).
set -u

usage() {
    echo "usage: reap [--keep-pgid N]... [--keep-tree PID]..." >&2
    exit 2
}

number() {
    case "$1" in '' | *[!0-9]*) echo "reap: not a number: $1" >&2; exit 2 ;; esac
}

keep_pgid=" "
kept=" "
while [ $# -gt 0 ]; do
    case "$1" in
        --keep-pgid | --keep-tree)
            [ $# -ge 2 ] || { echo "reap: $1 needs a value" >&2; exit 2; }
            number "$2"
            if [ "$1" = --keep-pgid ]; then keep_pgid="$keep_pgid$2 "; else kept="$kept$2 "; fi
            shift 2 ;;
        --keep-pgid=*) number "${1#*=}"; keep_pgid="$keep_pgid${1#*=} "; shift ;;
        --keep-tree=*) number "${1#*=}"; kept="$kept${1#*=} "; shift ;;
        *) usage ;;
    esac
done

# Prints "<state> <ppid> <pgid>" for a pid, or nothing if it is gone. comm (field 2) may contain spaces and
# parentheses, so the fields are taken after the last ")".
stat_of() {
    s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    [ -n "$s" ] || return 1
    rest=${s##*\) }
    set -- $rest
    echo "$1 $2 $3"
}

alive() {
    st=$(stat_of "$1") || return 1
    case "$st" in Z* | X*) return 1 ;; esac
    return 0
}

# Ancestor chain of this script (includes $$ itself).
protected=" 1 "
top=$$
p=$$
while [ "$p" -gt 1 ] 2>/dev/null; do
    protected="$protected$p "
    top=$p
    st=$(stat_of "$p") || break
    set -- $st
    p=$2
done
# The top ancestor below PID 1 (sandboxd) keeps its whole live subtree: in-flight Execute calls.
[ "$top" != "$$" ] && kept="$kept$top "

# One snapshot of every live process: "pid ppid pgid" per line.
snap=""
for d in /proc/[0-9]*; do
    pid=${d#/proc/}
    st=$(stat_of "$pid") || continue
    set -- $st
    case "$1" in Z* | X*) continue ;; esac
    snap="$snap$pid $2 $3
"
done

# Close the kept set over children: repeat until no process with a kept parent is missing from it.
if [ "$kept" != " " ]; then
    changed=1
    while [ $changed -eq 1 ]; do
        changed=0
        while read -r pid ppid pgid; do
            [ -n "$pid" ] || continue
            case "$kept" in *" $pid "*) continue ;; esac
            case "$kept" in *" $ppid "*) kept="$kept$pid "; changed=1 ;; esac
        done <<EOF
$snap
EOF
    done
fi

targets=""
while read -r pid ppid pgid; do
    [ -n "$pid" ] || continue
    case "$protected" in *" $pid "*) continue ;; esac
    case "$kept" in *" $pid "*) continue ;; esac
    case "$keep_pgid" in *" $pgid "*) continue ;; esac
    targets="$targets $pid"
done <<EOF
$snap
EOF

n=0
for pid in $targets; do
    kill -TERM "$pid" 2>/dev/null && n=$((n + 1))
done

if [ -n "$targets" ]; then
    i=0
    while [ $i -lt 20 ]; do
        left=""
        for pid in $targets; do alive "$pid" && left="$left $pid"; done
        targets=$left
        [ -z "$targets" ] && break
        sleep 0.1
        i=$((i + 1))
    done
    for pid in $targets; do kill -KILL "$pid" 2>/dev/null; done
fi

echo "$n"
