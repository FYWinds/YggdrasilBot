# Local development: copy to .env (read by every process started from the repo root).
# Full list and defaults: yggdrasil/config.py.

YGG_ENV=dev
# 8192: the port the dashboard's Vite dev server proxies /api to.
YGG_PORT=8192

# Postgres with pg_search + pgvector (e.g. the paradedb/paradedb:0.26.0-pg18 container) and Redis.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ygg
POSTGRES_PASSWORD=ygg
POSTGRES_DB=ygg
REDIS_URL=redis://127.0.0.1:6379/0

# Fernet key for provider API keys at rest:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YGG_SECRET_KEY=
# Shared with your OneBot endpoint's reverse WebSocket client (ws://127.0.0.1:8192/onebot/v11/ws).
ONEBOT_ACCESS_TOKEN=change-me

# QQ numbers allowed to run admin commands (JSON list).
YGG_SUPERUSERS=[10001]
# Dev only: treat every dashboard request as this admin (no auth proxy needed).
YGG_DEV_ADMIN_EMAIL=dev@localhost

# Optional: the render service (render_* tools and read_url's browser fallback).
# YGG_RENDER_URL=http://127.0.0.1:8580
# YGG_BROWSER_WS_URL=ws://127.0.0.1:3000/

LOG_LEVEL=DEBUG
